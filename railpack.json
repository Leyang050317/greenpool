{
    "$schema": "https://schema.railpack.com",
    "provider": "php",
    "packages": {
        "python": "3.12"
    },
    "steps": {
        "install": {
            "commands": [
                "...",
                {
                    "src": "ocr/requirements.txt",
                    "dest": "ocr/requirements.txt"
                },
                "python -m pip install --no-cache-dir -r ocr/requirements.txt"
            ]
        }
    }
}

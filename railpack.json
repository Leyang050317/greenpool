{
    "$schema": "https://schema.railpack.com",
    "provider": "php",
    "packages": {
        "python": "3.12"
    },
    "steps": {
        "build": {
            "commands": [
                "...",
                "python -m venv .venv-ocr",
                ".venv-ocr/bin/python -m pip install --no-cache-dir -r ocr/requirements.txt"
            ]
        }
    },
    "deploy": {
        "aptPackages": [
            "libgomp1",
            "libgl1"
        ]
    }
}

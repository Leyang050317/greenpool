APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

OCR_PYTHON_BINARY=python
OCR_TIMEOUT=120
OCR_LOW_CONFIDENCE_THRESHOLD=0.75
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

LOCAL_VEHICLE_VISION_ENABLED=true
LOCAL_VEHICLE_VISION_NODE="C:\\Program Files\\nodejs\\node.exe"
LOCAL_VEHICLE_VISION_MODEL=Xenova/clip-vit-base-patch32
LOCAL_VEHICLE_VISION_TIMEOUT=180

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Fare recommendation inputs. RON95 is used as a consistent reference price;
# update it when Malaysia's weekly pump price changes.
FARE_BASE_FARE=2.00
FARE_MINIMUM_FARE=3.00
FARE_MAINTENANCE_RATE_PER_KM=0.20
FARE_RON95_PRICE=3.82
GOOGLE_MAPS_API_KEY=
# Browser-restricted key for the Google Maps JavaScript API. Do not reuse a
# server-restricted Places/Routes key here.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_PLACES_MAX_CALLS_PER_DAY=500
GOOGLE_PLACES_MAX_CALLS_PER_MINUTE=60

# Optional AI answers for GreenPool Help Bot. Leave disabled to use FAQ-only answers.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
